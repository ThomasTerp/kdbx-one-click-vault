{
	"extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
	"include": ["src/renderer/src/**/*", "src/renderer/src/**/*.tsx", "src/preload/*.d.ts", "src/models/**/*"],
	"compilerOptions": {
		"composite": true,
		"moduleResolution": "bundler",
		"paths": {
			"@renderer/*": ["./src/renderer/src/*"],
			"@/*": ["./src/renderer/src/*"]
		}
	}
}
